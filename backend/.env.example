# --- Required -------------------------------------------------------------
# OpenAI API key. Lives ONLY in the backend; never commit the real value.
OPENAI_API_KEY=sk-replace-me

# --- AI models (swap without code changes) --------------------------------
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_MS=30000

# --- Server ---------------------------------------------------------------
PORT=3000
# Comma-separated list of allowed browser origins (Vite dev server by default).
CORS_ORIGIN=http://localhost:5173
CHAT_RATE_LIMIT_PER_MIN=20

# --- Knowledge base & retrieval -------------------------------------------
# Folder with the .md articles (relative to backend/ or absolute). Docker overrides this to /app/source.
SOURCE_DIR=../source
LOAD_DOCUMENTS_ON_STARTUP=true
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
# Cosine-similarity floor. Below it the question is refused without calling the LLM.
MIN_SIMILARITY=0.3
